# Yahoo Fantasy Sports credentials
# Copy this file to .env and fill in values (never commit .env)

# Yahoo OAuth credentials (for future automation via Yahoo Fantasy API)
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here
YAHOO_REFRESH_TOKEN=your_refresh_token_here

# Alternatively, Yahoo session cookie (if using session-based auth)
YAHOO_SESSION_COOKIE=

# Discord webhook for notifications (Phase 3)
DISCORD_WEBHOOK_URL=
